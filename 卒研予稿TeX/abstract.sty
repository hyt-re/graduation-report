%%%%  Set Size   %%%%
\setlength\paperheight {297mm}
\setlength\paperwidth  {210mm}
\setlength\oddsidemargin{-6mm}
\setlength\evensidemargin{0mm}
\setlength\textwidth{51zw}
\setlength\topmargin{-7mm}
\setlength\headheight{5mm}
\setlength\headsep{7mm}
\setlength\textheight{250mm}
\setlength{\columnsep}{3zw}

\setlength\textfloatsep{1zw} % 本文と図の間の余白
\setlength\intextsep{0pt} % 本文中の図の余白
\setlength\abovecaptionskip{0pt} % 図とキャプションの間の余白
\setlength\floatsep{1zw} % 図と図の間の余白

\sloppy

\def\title#1{\gdef\@title{#1}}%
\def\author#1{\gdef\@author{#1}}%
\def\adviser#1{\gdef\@adviser{#1}}%
\def\year#1{\gdef\@year{#1}}%
\def\num#1{\gdef\@num{#1}}%
\def\kind#1{\gdef\@kind{#1}}%

%%%% Head %%%%%
\def\ps@myheading{%
   \let\@mkboth=\@gobbletwo
   \def\@evenfoot{}%
   \def\@oddfoot{}%
   \def\@evenhead{}%
   \def\@oddhead{
    \underline{\hbox to \textwidth %
    {令和{\@year}年度　卒業研究{\@kind}発表会 \hfill 神戸高専電子工学科　No.{\@num}}}%
}%
}%

%%%% Title Page %%%%
\def\maketitle{%
	\twocolumn[
	\begin{center}%
		\Large\bfseries\@title
	\end{center}
	\begin{center}%
		{\large
		\begin{tabular}[t]{ll}%
        		\@author & 　　指導教員　 \@adviser \\
		\end{tabular}}%
	\end{center}
	\vskip 1.5em]}

%%% Caption %%%%%
\long\def\@makecaption#1#2{%
  \advance\leftskip1cm
  \advance\rightskip1cm
  \vskip\abovecaptionskip
  \iftdir\sbox\@tempboxa{#1\hskip1zw#2}%
    \else\sbox\@tempboxa{#1 #2}%
  \fi
  \ifdim \wd\@tempboxa >\hsize
    \iftdir #1\hskip1zw#2\relax\par
      \else #1 #2\relax\par\fi
  \else
    \global \@minipagefalse
    \hbox to\hsize{\hfil\box\@tempboxa\hfil}%
  \fi
  \vskip\belowcaptionskip}

%%% \Hline, \Vline %%%
\makeatletter
\def\@arrayrule{\@addtopreamble{%
\vrule \@width \arrayrulewidth}}
\def\Hline{\noalign{\hrule height 1.2pt}}
\def\Vline{\vrule width 1.2pt}
\def\nline{\noalign{\hrule height 0.2pt}}
\makeatother

%%% enumerate %%%
\def\labelenumi{\arabic{enumi})}%

%%% enumerate* %%%
\newenvironment{enumerate*}%
  {\begin{enumerate}%
    \setlength{\topsep}{0pt}%
    \setlength{\itemsep}{-1.2pt}%
    \setlength{\parsep}{0pt}}%
  {\end{enumerate}}

%%% itemize* %%%
\newenvironment{itemize*}%
  {\begin{itemize}%
    \setlength{\itemsep}{-1.2pt}%
    \setlength{\parsep}{0pt}}%
  {\end{itemize}}

%%% Section %%%
